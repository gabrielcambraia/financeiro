FINANCEIRO_CHAVE_HMAC_DOC=gere-com-openssl-rand-base64-32-para-hmac-documentos

# E-mail SMTP para envio de códigos OTP/verificação
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu-email@gmail.com
SPRING_MAIL_PASSWORD=sua-senha-de-app
FINANCEIRO_REMETENTE_EMAIL=noreply@financeiro.app
