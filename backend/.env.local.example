SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/financeiro
SPRING_DATASOURCE_USERNAME=financeiro
SPRING_DATASOURCE_PASSWORD=financeiro
JWT_SECRET=gere-com-openssl-rand-base64-32-precisa-ter-32-bytes
COOKIE_SEGURO=false
# CORS_ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Cifragem de dados PII (CPF/CNPJ) — gerar com: openssl rand -base64 32
