<?xml version="1.0" encoding="UTF-8"?>
<!--
  Texto puro em qualquer ambiente (dev e prod): os logs de produção são lidos
  direto no dashboard/CLI do Render, sem agregador que parseie JSON, então
  legibilidade humana vale mais que estrutura. Stack traces saem com quebra
  de linha real (%n), não escapadas.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level [%X{idRequisicao}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
